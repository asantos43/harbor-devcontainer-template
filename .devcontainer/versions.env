# Single source of truth for the pinned toolchain.
#
# This file is COPYed by the Dockerfile, so editing it invalidates the build cache
# and the next rebuild reinstalls at the new versions. update-toolchain.sh rewrites
# it; devcontainer feature versions live in devcontainer.json + devcontainer-lock.json
# instead, because `devcontainer upgrade` owns those.

HARBOR_VERSION=0.22.0
PYTHON_VERSION=3.13
UV_VERSION=0.12.9

# Agent CLIs (Claude Code, OpenCode) are off by default: they are only needed to run
# `harbor run -a claude-code` locally, and they add build time. Set to 1 to install.
INSTALL_AGENT_CLIS=0
